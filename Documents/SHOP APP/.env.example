# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay Configuration (Test Mode)
# Razorpay Key ID used on client app to initiate payment sheet
# Note: Key Secret is NEVER stored in the client app! It only lives in Supabase Edge Functions.
RAZORPAY_KEY_ID=rzp_test_your_key_id

# Shop Details
